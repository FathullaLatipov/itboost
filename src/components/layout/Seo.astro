---
/**
 * <head> SEO: title/description, canonical + hreflang, icons/manifest, Open Graph / Twitter,
 * and schema.org JSON-LD (@graph: Organization+ProfessionalService, WebSite, WebPage).
 * Facts come only from src/content/site.ts and src/content/services.ts.
 * `noindex` pages (e.g. 404) get no canonical / hreflang / JSON-LD.
 */
import type { Lang } from '@/i18n';
import { htmlLang, languages, ogLocale as ogLocales } from '@/i18n';
import { site } from '@/content/site';
import { services } from '@/content/services';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonical: string;
  alternates: { lang: string; href: string }[];
  xDefault: string;
  ogLocale: string;
  noindex?: boolean;
}

const { lang, title, description, canonical, alternates, xDefault, ogLocale, noindex = false } = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const abs = (path: string): string => new URL(path, siteUrl).href;
const home = abs('/');

/** Describes public/og-image.png (generated by tools/make-og.py — the card text is Russian). */
const OG_IMAGE_ALT = 'ITBoost — Цифровые системы, которые ускоряют ваш бизнес. itboost.uz · Ташкент';
const ogImage = abs('/og-image.png');
const ogAlternateLocales = languages.filter((l) => l !== lang).map((l) => ogLocales[l]);

const telephone = site.phone.href.replace(/^tel:/, '');
const socialUrls: readonly string[] = Object.values(site.social);
const sameAs = socialUrls.filter((url) => url !== '');
const orgId = `${home}#organization`;
const websiteId = `${home}#website`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': orgId,
      name: site.name,
      url: home,
      logo: { '@type': 'ImageObject', url: abs('/icon-512.png'), width: 512, height: 512 },
      image: ogImage,
      email: site.email,
      telephone,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Tashkent',
        addressCountry: 'UZ',
      },
      areaServed: { '@type': 'Country', name: 'Uzbekistan' },
      knowsLanguage: ['ru', 'uz'],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        telephone,
        email: site.email,
        availableLanguage: ['ru', 'uz'],
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: site.name,
        itemListElement: services.map((service) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: service.copy[lang].title },
        })),
      },
      ...(sameAs.length > 0 ? { sameAs } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: home,
      name: site.name,
      inLanguage: languages.map((l) => htmlLang[l]),
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: htmlLang[lang],
      isPartOf: { '@id': websiteId },
      about: { '@id': orgId },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
    },
  ],
};
// Escape "<" so no string can ever close the <script> element.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
{
  !noindex && (
    <>
      <link rel="canonical" href={canonical} />
      {alternates.map((a) => (
        <link rel="alternate" hreflang={a.lang} href={a.href} />
      ))}
      <link rel="alternate" hreflang="x-default" href={xDefault} />
    </>
  )
}

<meta name="theme-color" content="#070d1a" />
<meta name="color-scheme" content="dark light" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
{ogAlternateLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={OG_IMAGE_ALT} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

{!noindex && <script type="application/ld+json" set:html={jsonLdText} />}
