---
/**
 * Project index card. Two actions, as on the original site:
 * - the card's main (stretched) link opens the live project in a new tab;
 * - a separate icon button opens the screenshot in the lightbox.
 * Phones (<640px, single column): a compact list row — thumbnail · name / format / platforms · zoom.
 */
import { Picture } from 'astro:assets';
import type { Lang } from '@/i18n';
import type { Project } from '@/content/projects';
import { workSection } from '@/content/projects';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import DeviceFrame from './DeviceFrame.astro';
import type { LightboxImage } from './media';
import { fillName, lightboxAttrs } from './media';

interface Props {
  project: Project;
  lang: Lang;
  lightbox: LightboxImage;
  /** Position in the grid — drives the reveal stagger. */
  index: number;
}

const { project, lang, lightbox, index } = Astro.props;
const { labels } = workSection[lang];
const copy = project.copy[lang];
const alt = fillName(labels.shot, project.name);
const isPhone = project.device === 'phone';
---

<li class="pcard" data-category={project.category} data-id={project.id}>
  <article class="pcard__inner" data-reveal style={`--i:${index % 3}`}>
    <div class="pcard__media" data-cursor="view" data-cursor-label={labels.view}>
      <DeviceFrame device={project.device} label={project.linkLabel} fit="fill" size="sm">
        {
          isPhone ? (
            <Picture
              src={project.image}
              alt={alt}
              width={420}
              widths={[180, 280, 420]}
              sizes="140px"
              formats={['avif']}
              fallbackFormat="webp"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Picture
              src={project.image}
              alt={alt}
              width={960}
              widths={[480, 720, 960]}
              sizes="(min-width: 1440px) 420px, (min-width: 1024px) 30vw, (min-width: 640px) 46vw, 8rem"
              formats={['avif']}
              fallbackFormat="webp"
              loading="lazy"
              decoding="async"
            />
          )
        }
      </DeviceFrame>
    </div>

    <div class="pcard__body">
      <h4 class="pcard__title t-h4">
        <a
          class="pcard__link"
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          data-cursor="view"
          data-cursor-label={labels.view}
        >
          {project.name}<span class="sr-only"> — {labels.open}, {labels.newTab}</span>
        </a>
      </h4>
      <span class="pcard__arrow" aria-hidden="true">
        <Icon name="arrow-up-right" size={18} />
      </span>
      <p class="pcard__format">{copy.format}</p>
      <ul class="pcard__platforms" role="list" aria-label={labels.platform}>
        {
          project.platforms.map((platform) => (
            <li>
              <Badge variant="mono">{platform}</Badge>
            </li>
          ))
        }
      </ul>
    </div>

    <button
      type="button"
      class="pcard__zoom"
      aria-label={`${labels.zoom}: ${project.name}`}
      aria-haspopup="dialog"
      {...lightboxAttrs(project, lightbox, alt)}
    >
      <Icon name="zoom" size={18} />
    </button>
  </article>
</li>

<style>
  .pcard {
    min-width: 0;
    border-radius: var(--radius-sm);
  }

  .pcard__inner {
    position: relative;
    display: grid;
    grid-template-areas:
      'media'
      'body';
    height: 100%;
  }

  /* 16/9 box → ~2:1 screenshot view under the bar: minimal side-cropping of wide captures */
  .pcard__media {
    grid-area: media;
    aspect-ratio: 16 / 9;
    min-width: 0;
  }

  .pcard__media :global(.frame) {
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .pcard__media :global(.frame__media img) {
    transform-origin: 50% 0;
    transition: transform var(--dur-3) var(--ease-out);
  }

  /* individual transform props: the frame already uses `transform` to centre the phone */
  .pcard__media :global(.frame__phone) {
    transition:
      translate var(--dur-3) var(--ease-out),
      scale var(--dur-3) var(--ease-out);
  }

  /* ---- Body ------------------------------------------------------------------ */
  .pcard__body {
    grid-area: body;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'title arrow'
      'format platforms';
    align-items: center;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    padding-top: var(--space-4);
  }

  .pcard__title {
    grid-area: title;
    min-width: 0;
  }

  .pcard__link {
    border-radius: 0;
  }

  /* Stretched link: the whole card opens the project */
  .pcard__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-sm);
  }

  /* Focus ring around the whole card (the link is visually the whole card) */
  .pcard__link:focus-visible {
    outline: none;
  }

  /* on the li: the revealed article is clip-path'ed to its own box */
  .pcard:has(.pcard__link:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 8px;
    border-radius: var(--radius-sm);
  }

  @supports not selector(:has(*)) {
    .pcard__link {
      display: inline-block;
    }

    .pcard__link:focus-visible::after {
      outline: 2px solid var(--focus-ring);
      outline-offset: 8px;
    }
  }

  .pcard__arrow {
    grid-area: arrow;
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--fg-muted);
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .pcard__format {
    grid-area: format;
    min-width: 0;
    color: var(--fg-muted);
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .pcard__platforms {
    grid-area: platforms;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  /* ---- Lightbox button ----------------------------------------------------- */
  .pcard__zoom {
    grid-area: media;
    align-self: end;
    justify-self: end;
    position: relative;
    z-index: 2;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: var(--space-3);
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    /* solid chip instead of backdrop blur: 20 blurred chips over images were costly to scroll */
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    color: var(--fg);
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .pcard__zoom:focus-visible {
    border-radius: 50%;
    outline-offset: 3px;
  }

  /* ---- Interaction ----------------------------------------------------------- */
  /* Hover styles live in (hover: hover) only, so a tap on a touch screen never leaves them stuck. */
  .pcard:focus-within .pcard__media :global(.frame) {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
  }

  .pcard:focus-within .pcard__arrow {
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (hover: hover) {
    .pcard:hover .pcard__media :global(.frame) {
      border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    }

    .pcard:hover .pcard__arrow {
      color: var(--on-accent);
      background: var(--accent);
      border-color: var(--accent);
    }

    .pcard__arrow {
      opacity: 0;
      transform: translate(-6px, 6px) scale(0.85);
    }

    .pcard:is(:hover, :focus-within) .pcard__arrow {
      opacity: 1;
      transform: none;
    }

    .pcard:hover .pcard__media :global(.frame__media img) {
      transform: scale(1.04);
    }

    .pcard:hover .pcard__media :global(.frame__phone) {
      translate: 0 -4px;
      scale: 1.03;
    }

    .pcard__zoom {
      opacity: 0;
      transform: scale(0.9);
    }

    .pcard:is(:hover, :focus-within) .pcard__zoom {
      opacity: 1;
      transform: none;
    }

    .pcard__zoom:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--on-accent);
    }
  }
  /* ---- Phones: compact list row ------------------------------------------------ */
  /* thumbnail (zoom chip on its corner, as on the desktop card) · name ↗ / format / platforms */
  @media (max-width: 639.98px) {
    .pcard__inner {
      grid-template-columns: clamp(6.25rem, 30vw, 8rem) minmax(0, 1fr);
      grid-template-areas: 'media body';
      align-items: center;
      column-gap: var(--space-4);
      padding-block: var(--space-4);
      border-bottom: 1px solid var(--line);
    }

    .pcard__media {
      aspect-ratio: 4 / 3;
    }

    /* slim browser chrome on a thumbnail: dots only */
    .pcard__media :global(.frame) {
      --bar-h: 12px;
      --dot: 3px;
      --frame-radius: var(--radius-xs);
    }

    .pcard__media :global(.frame__url) {
      display: none;
    }

    .pcard__media :global(.frame__phone) {
      padding: 2px;
      border-radius: 8px;
    }

    .pcard__media :global(.frame__screen) {
      border-radius: 6px;
    }

    /* name + arrow on one line (the arrow follows the name), then format, then platforms */
    .pcard__body {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      column-gap: var(--space-2);
      row-gap: 0.2rem;
      padding-top: 0;
    }

    .pcard__title {
      flex: 0 1 auto;
    }

    .pcard__arrow {
      flex: none;
      width: auto;
      height: auto;
      border: 0;
      border-radius: 0;
      color: var(--accent-text);
    }

    .pcard:is(:hover, :focus-within) .pcard__arrow {
      color: var(--accent-text);
      background: none;
    }

    .pcard__format {
      flex: 1 0 100%;
      line-height: 1.35;
    }

    .pcard__platforms {
      flex: 1 0 100%;
      justify-content: flex-start;
      margin-top: 0.3rem;
    }

    .pcard__platforms :global(.badge) {
      min-height: 22px;
      padding: 0.1rem 0.55rem;
    }

    /* 44px hit area, 30px visible chip tucked into the thumbnail's corner */
    .pcard__zoom {
      margin: -4px;
      border: 0;
      background: none;
    }

    .pcard__zoom::before {
      content: '';
      position: absolute;
      inset: 7px;
      z-index: -1;
      border: 1px solid var(--line-strong);
      border-radius: 50%;
      background: color-mix(in srgb, var(--bg) 90%, transparent);
      transition:
        background-color var(--dur-2) var(--ease-out),
        border-color var(--dur-2) var(--ease-out);
    }

    .pcard__zoom :global(svg) {
      width: 15px;
      height: 15px;
    }

    .pcard__zoom:hover {
      background: none;
    }

    .pcard__zoom:focus-visible {
      outline-offset: -4px;
      color: var(--on-accent);
    }

    .pcard__zoom:focus-visible::before {
      background: var(--accent);
      border-color: var(--accent);
    }

    @media (hover: hover) {
      .pcard__zoom:hover::before {
        background: var(--accent);
        border-color: var(--accent);
      }
    }

    .pcard:has(.pcard__link:focus-visible) {
      outline-offset: 2px;
    }
  }
</style>
