---
/**
 * About — who we are (scroll-lit editorial statement), how we work (principles),
 * and why clients come (problems → solutions, each linked to a service + contact CTA).
 * Light section; the section's h2 is the eyebrow label, the statement is the visual lead.
 */
import type { Lang } from '@/i18n';
import { about } from '@/content/about';
import Statement from './about/Statement.astro';
import Principles from './about/Principles.astro';
import ProblemSolutions from './about/ProblemSolutions.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = about[lang];
---

<section id="about" class="section about" data-theme="light" aria-labelledby="about-title">
  <div class="container">
    <div class="about__intro">
      <h2 id="about-title" class="about__eyebrow t-meta" data-reveal="fade">
        <span class="about__index" aria-hidden="true">01</span>
        <span class="about__rule" aria-hidden="true"></span>
        <span>{t.eyebrow}</span>
      </h2>

      <div class="about__main">
        <Statement text={t.statement} highlight="ITBoost" />
        <Principles items={t.principles} />
      </div>
    </div>

    <div class="about__ps">
      <ProblemSolutions lang={lang} />
    </div>
  </div>
</section>

<style>
  .about__intro {
    display: grid;
    gap: var(--space-6);
  }

  .about__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    align-self: start;
    font-weight: var(--weight-regular);
  }

  .about__index {
    color: var(--accent-text);
  }

  .about__rule {
    width: 2.5rem;
    height: 1px;
    background: var(--line-strong);
  }

  .about__main {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 6.5rem);
  }

  .about__ps {
    margin-top: clamp(5rem, 3rem + 7vw, 10rem);
  }

  @media (max-width: 767.98px) {
    .about__intro {
      gap: var(--space-5);
    }

    .about__main {
      gap: var(--space-7);
    }

    .about__ps {
      margin-top: var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .about__intro {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }

    .about__eyebrow {
      grid-column: 1 / span 3;
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      /* optical alignment with the statement's first line */
      padding-top: 0.9rem;
    }

    .about__main {
      grid-column: 4 / -1;
    }
  }
</style>

<script>
  import '@/scripts/about';
</script>
