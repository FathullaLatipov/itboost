---
/**
 * 06 — Process. Sticky intro + progress (desktop) and a scroll-linked vertical timeline.
 * Without JS / with reduced motion every step is rendered active and the line is fully drawn;
 * src/scripts/process.ts adds `.is-live` and drives `--fill` / `.is-active` while in view.
 */
import type { Lang } from '@/i18n';
import { anchor } from '@/i18n';
import { processSection } from '@/content/process';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = processSection[lang];
const total = t.steps.length;
const pad = (n: number): string => String(n).padStart(2, '0');
---

<section id="process" class="section section--divided process" data-theme="light" aria-labelledby="process-title" data-process>
  <div class="container process__layout">
    <div class="process__aside">
      <SectionHeading index="06" eyebrow={t.eyebrow} title={t.title} lead={t.lead} id="process-title" class="process__heading" />

      <div class="process__progress" aria-hidden="true" data-reveal style="--i:3">
        <p class="process__counter t-meta">
          <span>{t.stepLabel}</span>
          <span class="process__count">
            <span class="process__current" data-process-current>{pad(total)}</span>
            <span class="process__total">/ {pad(total)}</span>
          </span>
        </p>
        <span class="process__bar">
          <span class="process__bar-fill" data-process-bar></span>
        </span>
      </div>

      <div class="process__cta" data-reveal style="--i:4">
        <Button href={anchor(lang, 'contact')} variant="secondary">{t.cta}</Button>
      </div>
    </div>

    <ol class="process__list" role="list" data-process-list>
      {
        t.steps.map((step, i) => (
          <li class="process-step is-active" data-process-step data-reveal style={`--i:${Math.min(i, 2)}`}>
            {i < total - 1 && (
              <span class="process-step__rail" aria-hidden="true">
                <span class="process-step__fill" />
              </span>
            )}
            <span class="process-step__node" aria-hidden="true" data-process-node>
              <svg viewBox="0 0 20 18" width="20" height="18" focusable="false">
                <path class="process-step__halo" d="M5.25 1h9.5l4.6 8-4.6 8h-9.5L.65 9Z" />
                <path class="process-step__hex" d="M5.25 1h9.5l4.6 8-4.6 8h-9.5L.65 9Z" />
                <path class="process-step__hex-core" d="M7.4 5h5.2l2.3 4-2.3 4H7.4L5.1 9Z" />
              </svg>
            </span>
            <span class="process-step__num" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <div class="process-step__body">
              <h3 class="process-step__title t-h3">{step.title}</h3>
              <p class="process-step__text">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    --rail-w: 1.75rem;
    --step-pad: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    --num-size: 1rem;
    --num-line: 1.5rem;
    /* centre of the hex node, measured from the top of a step */
    --node-y: calc(var(--step-pad) + var(--num-line) / 2);
    --node-w: 20px;
    --node-h: 18px;
  }

  .process__layout {
    display: grid;
    gap: 0;
  }

  /* ---- Aside: heading + progress + CTA ------------------------------------ */
  .process__aside {
    display: grid;
    align-content: start;
  }

  .process__progress {
    display: none;
  }

  .process__cta {
    order: 2;
    margin-top: var(--space-7);
  }

  .process__counter {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .process__count {
    display: inline-flex;
    gap: 0.6em;
    font-variant-numeric: tabular-nums;
    color: var(--fg-muted);
  }

  .process__current {
    color: var(--accent-text);
  }

  .process__bar {
    position: relative;
    display: block;
    height: 1px;
    background: var(--line-strong);
  }

  .process__bar-fill {
    position: absolute;
    inset: -0.5px 0;
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(var(--progress, 1));
  }

  /* ---- Timeline ------------------------------------------------------------ */
  .process__list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .process-step {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail-w) minmax(0, 1fr);
    grid-template-areas:
      'rail num'
      'rail body';
    padding-block: var(--step-pad);
  }

  /* hairline rule between steps, starting after the rail */
  .process-step::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--rail-w);
    right: 0;
    height: 1px;
    background: var(--line);
  }

  .process-step__rail {
    position: absolute;
    top: var(--node-y);
    left: calc(var(--node-w) / 2 - 0.5px);
    width: 1px;
    height: 100%;
    background: var(--line-strong);
  }

  .process-step__fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -0.5px;
    width: 2px;
    background: var(--accent);
    transform-origin: center top;
    transform: scaleY(var(--fill, 1));
  }

  .process-step__node {
    position: absolute;
    z-index: 1;
    top: calc(var(--node-y) - var(--node-h) / 2);
    left: 0;
    width: var(--node-w);
    height: var(--node-h);
    color: var(--accent);
  }

  .process-step__node svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .process-step__hex {
    fill: var(--bg);
    stroke: var(--line-strong);
    stroke-width: 1.25;
    transition:
      stroke var(--dur-2) var(--ease-out),
      fill var(--dur-2) var(--ease-out);
  }

  /* "you are here" halo on the latest active step (script-driven) */
  .process-step__halo {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.6;
    transform-origin: 10px 9px;
    transform: scale(1);
    opacity: 0;
    transition:
      transform var(--dur-3) var(--ease-out),
      opacity var(--dur-2) var(--ease-out);
  }

  .process.is-live .process-step.is-current .process-step__halo {
    transform: scale(1.75);
    opacity: 0.45;
  }

  .process-step__hex-core {
    fill: var(--accent);
    transform-origin: 10px 9px;
    transform: scale(0);
    opacity: 0;
    transition:
      transform var(--dur-2) var(--ease-spring),
      opacity var(--dur-1) var(--ease-out);
  }

  .process-step__num {
    grid-area: num;
    font-family: var(--font-mono);
    font-size: var(--num-size);
    line-height: var(--num-line);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--fg-faint);
    transition: color var(--dur-2) var(--ease-out);
  }

  .process-step__body {
    grid-area: body;
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-2);
    max-width: 34rem;
  }

  .process-step__title {
    color: var(--fg);
    transition: color var(--dur-2) var(--ease-out);
  }

  .process-step__text {
    color: var(--fg-muted);
    transition: color var(--dur-2) var(--ease-out);
  }

  /* Active (default without JS) */
  .process-step.is-active .process-step__hex {
    stroke: var(--accent);
  }

  .process-step.is-active .process-step__hex-core {
    transform: scale(1);
    opacity: 1;
  }

  .process-step.is-active .process-step__num {
    color: var(--accent-text);
  }

  /* Inactive — only once the script drives the timeline. Colours stay AA on paper. */
  .process.is-live .process-step:not(.is-active) .process-step__title {
    color: var(--fg-muted);
  }

  .process.is-live .process-step:not(.is-active) .process-step__text {
    color: var(--fg-faint);
  }

  /* ---- Phones: number beside the title, tighter steps --------------------------- */
  @media (max-width: 767.98px) {
    .process {
      --step-pad: 1.25rem;
      /* line box = first line of the h3, so number, node and title share a centre line */
      --num-size: var(--text-meta);
      --num-line: calc(var(--text-h3) * 1.3);
    }

    .process-step {
      grid-template-columns: var(--rail-w) 2rem minmax(0, 1fr);
      grid-template-areas: 'rail num body';
      align-items: start;
    }

    .process-step__num {
      letter-spacing: var(--tracking-meta);
    }

    .process-step__body {
      gap: var(--space-2);
      margin-top: 0;
    }

    .process__cta {
      margin-top: var(--space-6);
    }
  }

  /* ---- ≥ 768: number beside the title ------------------------------------ */
  @media (min-width: 768px) {
    .process {
      --rail-w: 3rem;
      --num-size: clamp(1.75rem, 1.2rem + 1.1vw, 2.5rem);
      /* line box = first line of the h3, so number and title share a centre line */
      --num-line: calc(var(--text-h3) * 1.3);
    }

    .process-step {
      grid-template-columns: var(--rail-w) clamp(4.5rem, 3rem + 3vw, 7rem) minmax(0, 1fr);
      grid-template-areas: 'rail num body';
      align-items: start;
    }

    .process-step__node {
      left: calc(var(--rail-w) / 2 - var(--node-w) / 2);
    }

    .process-step__rail {
      left: calc(var(--rail-w) / 2 - 0.5px);
    }

    .process-step__body {
      margin-top: 0;
    }
  }

  /* ---- ≥ 1024: two columns, sticky aside --------------------------------- */
  @media (min-width: 1024px) {
    .process__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(3rem, 1rem + 5vw, 8rem);
      align-items: start;
    }

    .process__aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }

    .process__aside :global(.section-heading) {
      margin-bottom: var(--space-7);
    }

    .process__progress {
      display: block;
      max-width: 22rem;
    }

    .process__cta {
      order: 0;
      margin-top: var(--space-6);
    }

    .process__list {
      margin-top: calc(var(--step-pad) * -1 + 0.4rem);
      border-bottom: 0;
    }

    .process-step:first-child::before {
      display: none;
    }
  }

  /* Short desktop viewports: sticky aside would not fit */
  @media (min-width: 1024px) and (max-height: 620px) {
    .process__aside {
      position: static;
    }
  }

  @media (max-width: 1023px) {
    /* Mobile/tablet: aside dissolves so the CTA can follow the timeline */
    .process__aside {
      display: contents;
    }

    .process__list {
      order: 1;
    }
  }
</style>

<script>
  import '@/scripts/process';
</script>
