---
/**
 * Decorative hexagon lattice for the service detail panel.
 * The outer ring is split into one segment per service; the accent segment travels to the
 * active service's slot (driven by `--svc-step` on an ancestor), the inner hex turns with it.
 */
interface Props {
  count: number;
  class?: string;
}

const { count, class: className } = Astro.props;

/** Flat-top hexagon (pointy left/right, like the logo) centred on 0,0. */
const hex = (r: number): string => {
  const h = (r * Math.sqrt(3)) / 2;
  const p = (x: number, y: number): string => `${Math.round(x * 100) / 100} ${Math.round(y * 100) / 100}`;
  return `M${p(r, 0)}L${p(r / 2, h)}L${p(-r / 2, h)}L${p(-r, 0)}L${p(-r / 2, -h)}L${p(r / 2, -h)}Z`;
};

const segment = 1 / count;
---

<svg class:list={['svc-hex', className]} viewBox="-100 -100 200 200" aria-hidden="true" focusable="false">
  <path class="svc-hex__ring" d={hex(96)} pathLength="1"></path>
  <path class="svc-hex__ticks" d={hex(96)} pathLength="1" style={`stroke-dasharray: 0.002 ${segment - 0.002}`}></path>
  <path
    class="svc-hex__segment"
    d={hex(96)}
    pathLength="1"
    style={`stroke-dasharray: ${segment} ${1 - segment}`}></path>
  <g class="svc-hex__inner">
    <path class="svc-hex__ring svc-hex__ring--mid" d={hex(68)}></path>
    <path class="svc-hex__ring svc-hex__ring--core" d={hex(40)}></path>
  </g>
</svg>

<style>
  .svc-hex {
    overflow: visible;
    fill: none;
    stroke-linejoin: round;
  }

  .svc-hex__ring {
    stroke: var(--line-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .svc-hex__ring--mid {
    stroke: var(--line);
  }

  .svc-hex__ring--core {
    stroke: var(--line-strong);
    stroke-dasharray: 2 3;
  }

  .svc-hex__ticks {
    stroke: var(--fg-faint);
    stroke-width: 9;
    stroke-linecap: butt;
    opacity: 0.6;
  }

  /* No vector-effect here: it breaks pathLength-based dashes in Chromium. */
  .svc-hex__segment {
    stroke: var(--accent);
    stroke-width: 4;
    stroke-linecap: butt;
    stroke-dashoffset: calc(var(--svc-step, 0) * -1 / var(--svc-count, 8));
    transition: stroke-dashoffset var(--dur-4) var(--ease-out);
  }

  .svc-hex__inner {
    transform: rotate(calc(var(--svc-step, 0) * 15deg));
    transition: transform var(--dur-4) var(--ease-out);
  }
</style>
