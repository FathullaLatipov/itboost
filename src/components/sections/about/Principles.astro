---
/**
 * Three working principles: mono index, hairline rule that draws in, title + muted text.
 */
import type { Principle } from '@/content/about';

interface Props {
  items: Principle[];
  class?: string;
}

const { items, class: className } = Astro.props;
const pad = (n: number): string => String(n).padStart(2, '0');
---

<ol class:list={['principles', className]} role="list">
  {
    items.map((item, i) => (
      <li class="principles__item" data-reveal style={`--i:${i + 1}`}>
        <span class="principles__num t-meta" aria-hidden="true">
          {pad(i + 1)}
        </span>
        <h3 class="principles__title t-h4">{item.title}</h3>
        <p class="principles__text">{item.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .principles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6) var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principles__item {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-top: var(--space-5);
  }

  /* Hairline that draws in from the left when the item is revealed. */
  .principles__item::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--line-strong);
    transform-origin: left center;
  }

  :global(.js) .principles__item::before {
    transform: scaleX(0);
    transition: transform 1s var(--ease-out);
    transition-delay: calc(var(--i, 0) * var(--stagger) + 80ms);
  }

  :global(.js) .principles__item:global(.is-visible)::before {
    transform: none;
  }

  .principles__num {
    color: var(--accent-text);
    margin-bottom: var(--space-2);
  }

  .principles__title {
    max-width: 22ch;
  }

  .principles__text {
    max-width: 36ch;
    color: var(--fg-muted);
  }

  /* Phones: three short items read best as a compact vertical list — number beside the title
     (as in the Process timeline), copy using the full column width. */
  @media (max-width: 767.98px) {
    .principles {
      gap: var(--space-5);
    }

    .principles__item {
      grid-template-columns: 2rem minmax(0, 1fr);
      column-gap: 0;
      row-gap: var(--space-2);
      padding-top: var(--space-4);
    }

    .principles__num {
      grid-row: 1;
      margin-bottom: 0;
      /* centre on the title's first line */
      line-height: calc(var(--text-h4) * 1.3);
    }

    .principles__title,
    .principles__text {
      grid-column: 2;
      max-width: 40rem;
    }
  }

  @media (min-width: 768px) {
    .principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .principles__item::before {
      transform: none;
    }
  }
</style>
