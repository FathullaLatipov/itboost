---
/**
 * Problems → solutions.
 * ≥1024px (with JS): list of problem rows (toggle buttons, aria-pressed) + a sticky solution panel
 *   that crossfades to the active item (aria-live). Hover / focus / click / arrow keys activate.
 * <1024px (with JS): accordion — each row is a button with aria-expanded revealing its solution inline.
 * No JS: every solution is shown inline under its problem; the panel stays hidden.
 * Only one of the two renderings is ever exposed (display:none on the other), so nothing is read twice.
 * Behaviour lives in src/scripts/about.ts.
 */
import type { Lang } from '@/i18n';
import { anchor } from '@/i18n';
import { about } from '@/content/about';
import { services, servicesSection } from '@/content/services';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SplitText from '@/components/ui/SplitText.astro';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = about[lang];
const cta = servicesSection[lang].cta;
const pad = (n: number): string => String(n).padStart(2, '0');
const total = pad(t.items.length);

const items = t.items.map((item, i) => {
  const service = services.find((s) => s.id === item.service);
  return {
    ...item,
    index: pad(i + 1),
    serviceTitle: service ? service.copy[lang].title : '',
    triggerId: `about-ps-trigger-${i}`,
    answerId: `about-ps-answer-${i}`,
  };
});
const panelId = 'about-ps-panel';
---

<div class:list={['ps', className]} data-ps>
  <div class="ps__head">
    <h3 class="ps__title t-h2" data-split>
      <SplitText text={t.problemsTitle} />
    </h3>
    <p class="ps__lead t-lead" data-reveal style="--i:2">{t.problemsLead}</p>
  </div>

  <div class="ps__body">
    <div class="ps__col">
      <p class="ps__col-label t-meta" id="about-ps-label" data-reveal="fade">
        <span>{t.problemLabel}</span>
        <span aria-hidden="true">{total}</span>
      </p>
      <ol class="ps__list" role="list" aria-labelledby="about-ps-label">
        {
          items.map((item, i) => (
            <li class:list={['ps__item', { 'is-on': i === 0 }]} data-ps-item data-reveal style={`--i:${i}`}>
              <button
                type="button"
                class="ps__trigger"
                id={item.triggerId}
                aria-expanded="true"
                aria-controls={item.answerId}
                data-ps-trigger
              >
                <span class="ps__num t-meta" aria-hidden="true">
                  {item.index}
                </span>
                <span class="ps__problem">{item.problem}</span>
                <span class="ps__icon ps__icon--toggle" aria-hidden="true">
                  <Icon name="plus" size={20} />
                </span>
                <span class="ps__icon ps__icon--arrow" aria-hidden="true">
                  <Icon name="arrow-right" size={22} />
                </span>
              </button>
              <div class="ps__answer" id={item.answerId} role="region" aria-labelledby={item.triggerId} data-ps-answer>
                <div class="ps__answer-inner">
                  <div class="ps__answer-body">
                    <p class="ps__answer-text">{item.solution}</p>
                    {item.serviceTitle && (
                      <p class="ps__service">
                        <span class="t-meta">{t.serviceLabel}</span>
                        <span class="ps__service-name">{item.serviceTitle}</span>
                      </p>
                    )}
                    <Button variant="ghost" href={anchor(lang, 'contact')} data-lead-service={item.service}>
                      {cta}
                    </Button>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="ps__panel" id={panelId} aria-live="polite" data-ps-panel data-reveal style="--i:2">
      <div class="ps__ticks" aria-hidden="true">
        {items.map((_, i) => <span class:list={['ps__tick', { 'is-active': i === 0 }]} data-ps-tick />)}
      </div>
      <div class="ps__slides">
        {
          items.map((item, i) => (
            <div
              class:list={['ps__slide', { 'is-active': i === 0 }]}
              data-ps-slide
              aria-hidden={i === 0 ? undefined : 'true'}
              inert={i !== 0}
            >
              <p class="ps__slide-top t-meta">
                <span>{t.solutionLabel}</span>
                <span aria-hidden="true">
                  {item.index} / {total}
                </span>
              </p>
              <p class="ps__solution">{item.solution}</p>
              <div class="ps__slide-foot">
                {item.serviceTitle && (
                  <p class="ps__service">
                    <span class="t-meta">{t.serviceLabel}</span>
                    <span class="ps__service-name">{item.serviceTitle}</span>
                  </p>
                )}
                <Button variant="ghost" href={anchor(lang, 'contact')} data-lead-service={item.service}>
                  {cta}
                </Button>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  /* ---- Head ---------------------------------------------------------------------- */
  .ps__head {
    display: grid;
    gap: var(--space-5);
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .ps__title {
    max-width: 16ch;
  }

  .ps__lead {
    max-width: 30rem;
  }

  /* ---- Problem list ------------------------------------------------------------- */
  .ps__col-label {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .ps__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .ps__item {
    border-top: 1px solid var(--line);
  }

  .ps__trigger {
    /* height of the problem's first line: number + icon are centred on it */
    --line-1: calc(var(--text-h3) * 1.25);
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: start;
    column-gap: var(--space-3);
    width: 100%;
    min-height: 64px;
    padding: clamp(1rem, 0.75rem + 0.7vw, 1.45rem) 0 clamp(1rem, 0.75rem + 0.7vw, 1.45rem) 1.25rem;
    text-align: left;
    color: var(--fg);
    transition: color var(--dur-2) var(--ease-out);
  }

  /* Accent bar: scales in on the active / open row. */
  .ps__trigger::before {
    content: '';
    position: absolute;
    left: 0;
    top: 22%;
    bottom: 22%;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .ps__trigger:focus-visible {
    outline-offset: -2px;
  }

  .ps__num {
    line-height: var(--line-1);
    color: var(--fg-faint);
    transition: color var(--dur-2) var(--ease-out);
  }

  .ps__problem {
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    line-height: 1.25;
    letter-spacing: var(--tracking-tight);
    text-wrap: pretty;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .ps__icon {
    display: inline-grid;
    place-items: center;
    justify-self: end;
    width: 2.75rem;
    height: 2.75rem;
    margin-block: calc((var(--line-1) - 2.75rem) / 2);
    color: var(--fg-faint);
    transition:
      color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      opacity var(--dur-2) var(--ease-out);
  }

  .ps__icon--toggle,
  .ps__icon--arrow {
    display: none;
  }

  /* ---- Answer (inline) --------------------------------------------------------- */
  .ps__answer-body {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: 0 0 var(--space-6) calc(1.25rem + 2.75rem + var(--space-3));
  }

  .ps__answer-text {
    max-width: 40rem;
    font-size: 1.0625rem;
    color: var(--fg);
  }

  .ps__service {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .ps__service-name {
    font-weight: var(--weight-semibold);
    color: var(--fg);
  }

  /* ---- Panel (desktop) --------------------------------------------------------- */
  .ps__panel {
    display: none;
  }

  .ps__ticks {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 6px;
    margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.25rem);
  }

  .ps__tick {
    height: 2px;
    border-radius: 2px;
    background: var(--line);
    transform-origin: left center;
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .ps__tick:global(.is-active) {
    background: var(--accent);
  }

  .ps__slides {
    display: grid;
  }

  .ps__slide {
    grid-area: 1 / 1;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-5);
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 10px, 0);
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      visibility 0s linear var(--dur-2);
  }

  .ps__slide:global(.is-active) {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity var(--dur-3) var(--ease-out) 60ms,
      transform var(--dur-3) var(--ease-out) 60ms,
      visibility 0s;
  }

  .ps__slide-top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .ps__slide-top span:first-child {
    color: var(--accent-text);
  }

  .ps__solution {
    font-size: clamp(1.25rem, 0.95rem + 0.6vw, 1.6rem);
    font-weight: var(--weight-medium);
    line-height: 1.35;
    letter-spacing: -0.018em;
    color: var(--fg);
  }

  .ps__slide-foot {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  /* ---- With JS: interactive states ------------------------------------------------ */
  :global(.js) .ps__trigger {
    color: var(--fg-muted);
  }

  :global(.js) .ps__item:global(.is-on) .ps__trigger {
    color: var(--fg);
  }

  :global(.js) .ps__item:global(.is-on) .ps__trigger::before {
    transform: scaleY(1);
  }

  :global(.js) .ps__item:global(.is-on) .ps__num {
    color: var(--accent-text);
  }

  @media (hover: hover) {
    :global(.js) .ps__trigger:hover {
      color: var(--fg);
    }
  }

  /* Accordion (< 1024px) */
  @media (max-width: 1023px) {
    :global(.js) .ps__icon--toggle {
      display: inline-grid;
    }

    :global(.js) .ps__item:global(.is-on) .ps__icon--toggle {
      color: var(--accent-text);
      transform: rotate(45deg);
    }

    :global(.js) .ps__answer {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows var(--dur-2) var(--ease-in-out),
        visibility 0s linear var(--dur-2);
    }

    :global(.js) .ps__item:global(.is-on) .ps__answer {
      grid-template-rows: 1fr;
      visibility: visible;
      transition:
        grid-template-rows var(--dur-2) var(--ease-in-out),
        visibility 0s;
    }

    .ps__answer-inner {
      min-height: 0;
      overflow: hidden;
    }

    :global(.js) .ps__answer-body {
      opacity: 0;
      transform: translate3d(0, -6px, 0);
      transition:
        opacity var(--dur-2) var(--ease-out),
        transform var(--dur-2) var(--ease-out);
    }

    :global(.js) .ps__item:global(.is-on) .ps__answer-body {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 479px) {
    .ps__trigger {
      grid-template-columns: 2rem minmax(0, 1fr) 2.75rem;
      column-gap: var(--space-2);
      padding-left: 0.9rem;
    }

    .ps__answer-body {
      padding-left: calc(0.9rem + 2rem + var(--space-2));
    }
  }

  /* Desktop: list + sticky panel */
  @media (min-width: 1024px) {
    .ps__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
    }

    .ps__title {
      grid-column: 1 / span 7;
    }

    .ps__lead {
      grid-column: 8 / -1;
    }

    /* label | list + panel share row 2, so the panel can match the list's height */
    :global(.js) .ps__body {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: start;
    }

    :global(.js) .ps__col {
      display: contents;
    }

    :global(.js) .ps__col-label {
      grid-column: 1 / span 7;
      grid-row: 1;
    }

    :global(.js) .ps__list {
      grid-column: 1 / span 7;
      grid-row: 2;
    }

    :global(.js) .ps__answer {
      display: none;
    }

    :global(.js) .ps__panel {
      grid-column: 8 / -1;
      grid-row: 2;
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      display: flex;
      flex-direction: column;
      /* as tall as the list, but never taller than the viewport (then it sticks) */
      min-height: min(100%, calc(100svh - var(--header-h) - var(--space-8)));
      padding: clamp(1.5rem, 0.75rem + 1.4vw, 2.5rem);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: var(--surface);
    }

    :global(.js) .ps__slides {
      flex: 1 0 auto;
    }

    :global(.js) .ps__icon--arrow {
      display: inline-grid;
      opacity: 0;
      transform: translate3d(-8px, 0, 0);
    }

    :global(.js) .ps__item:global(.is-on) .ps__icon--arrow {
      color: var(--accent-text);
      opacity: 1;
      transform: none;
    }

    :global(.js) .ps__item:global(.is-on) .ps__problem {
      transform: translate3d(0.4rem, 0, 0);
    }
  }
</style>
