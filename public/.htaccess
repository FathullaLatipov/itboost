# ==========================================================================
# ITBoost — Apache config for cPanel shared hosting (static Astro build).
# Kept conservative: every module-specific block is wrapped in <IfModule>.
# NOTE: Engintron (nginx) may serve static files directly and skip these
# headers/caching rules — see docs/DEPLOY.md.
# ==========================================================================

Options -Indexes
DirectoryIndex index.html index.php

# Astro emits dist/404.html from src/pages/404.astro
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# MIME types
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml                 .svg
  AddType image/x-icon                  .ico
  AddType image/avif                    .avif
  AddType image/webp                    .webp
  AddType font/woff2                    .woff2
  AddType application/manifest+json     .webmanifest
  AddCharset utf-8 .html .css .js .json .xml .txt .webmanifest .svg
</IfModule>

# --------------------------------------------------------------------------
# Redirects: legacy pages of the old site → home (301)
# --------------------------------------------------------------------------
<IfModule mod_alias.c>
  RedirectMatch 301 ^/inner-page\.html$ /
  RedirectMatch 301 ^/portfolio-details\.html$ /
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # /index.html and /uz/index.html → clean URL (only for direct requests, never for DirectoryIndex)
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  # Lead form endpoint: same path as the Vercel function (/api/lead) → PHP proxy (internal, POST kept)
  RewriteRule ^api/lead/?$ /api/lead.php [L]
</IfModule>

# --------------------------------------------------------------------------
# Compression
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml image/x-icon
</IfModule>

# --------------------------------------------------------------------------
# Caching
#   /_astro/*  content-hashed build assets → 1 year, immutable
#   HTML       always revalidate, so a deploy is visible immediately
#   other      (images/icons in public/) → 1 week
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 week"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/json          "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 hour"
  ExpiresByType text/xml                  "access plus 1 hour"
  ExpiresByType text/plain                "access plus 1 hour"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # ------------------------------------------------------------------------
  # Security headers (conservative; no CSP yet — see docs/DEPLOY.md)
  # ------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# --------------------------------------------------------------------------
# Never serve dotfiles / env files / editor leftovers (except .well-known)
# --------------------------------------------------------------------------
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.(?!well-known)|\.(env|log|bak|sql|ini|sh)$|~$)">
    Require all denied
  </FilesMatch>
</IfModule>
