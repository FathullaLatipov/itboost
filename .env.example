# ITBoost — build-time environment for the lead form.
# Copy to `.env` (gitignored) and fill in. Values prefixed with PUBLIC_ are inlined into the
# client JavaScript at build time — anything you put here is visible to every visitor.
# After changing .env, restart `astro dev` / re-run `npm run build`.

# ---------------------------------------------------------------------------
# Transport mode
#   telegram — the browser posts directly to the Telegram Bot API (legacy behaviour).
#              The bot token ends up in the public JS bundle. Use only as a stopgap.
#   proxy    — the browser posts JSON to PUBLIC_LEAD_ENDPOINT (public/api/lead.php),
#              which holds the token server-side. Recommended. See docs/DEPLOY.md.
# ---------------------------------------------------------------------------
PUBLIC_LEAD_MODE=telegram

# ---------------------------------------------------------------------------
# telegram mode only
# The token that shipped in the legacy site is compromised (it was public in index.html).
# Rotation: @BotFather -> /mybots -> <bot> -> API Token -> Revoke current token.
# When switching to proxy mode, REMOVE these two lines so the token is not bundled.
# ---------------------------------------------------------------------------
PUBLIC_TG_BOT_TOKEN=123456789:replace-with-bot-token
PUBLIC_TG_CHAT_ID=123456789

# ---------------------------------------------------------------------------
# proxy mode only (same-origin path; default shown)
# The server reads ITBOOST_TG_TOKEN / ITBOOST_TG_CHAT_ID from its environment or from
# ~/itboost-lead-config.php (outside public_html). Never put the token in this file for proxy mode.
# ---------------------------------------------------------------------------
PUBLIC_LEAD_ENDPOINT=/api/lead.php
