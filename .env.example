# ITBoost — build-time environment for the lead form.
# Copy to `.env` (gitignored) and fill in. Values prefixed with PUBLIC_ are inlined into the
# client JavaScript at build time — anything with that prefix is visible to every visitor.
# After changing .env, restart `astro dev` / re-run `npm run build`.

# ---------------------------------------------------------------------------
# Transport mode
#   proxy    — RECOMMENDED for production. The browser posts JSON to /api/lead, a server-side
#              proxy that holds the bot token:
#                Vercel → api/lead.js (Vercel Function)
#                cPanel → public/api/lead.php (via the /api/lead rewrite in .htaccess)
#              The token is set as a SERVER variable (no PUBLIC_ prefix), see below.
#   telegram — the browser posts directly to the Telegram Bot API. The bot token ends up in the
#              public JS bundle. Only for local development (astro dev cannot run /api/lead).
# ---------------------------------------------------------------------------
PUBLIC_LEAD_MODE=proxy

# Optional — proxy endpoint path (default /api/lead).
# PUBLIC_LEAD_ENDPOINT=/api/lead

# ---------------------------------------------------------------------------
# Server-side secrets for proxy mode (NO PUBLIC_ prefix → never sent to the browser)
#   Vercel: Settings → Environment Variables (mark ITBOOST_TG_TOKEN as Sensitive)
#   cPanel: environment variables or ~/itboost-lead-config.php (outside public_html)
# ---------------------------------------------------------------------------
# ITBOOST_TG_TOKEN=123456789:new-token-from-botfather
# ITBOOST_TG_CHAT_ID=123456789

# ---------------------------------------------------------------------------
# telegram mode only (local development). Rotate the legacy token — it was public:
# @BotFather -> /mybots -> <bot> -> API Token -> Revoke current token.
# ---------------------------------------------------------------------------
# PUBLIC_LEAD_MODE=telegram
# PUBLIC_TG_BOT_TOKEN=123456789:replace-with-bot-token
# PUBLIC_TG_CHAT_ID=123456789
