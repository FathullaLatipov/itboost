# ITBoost — server-side settings for the lead form.
# The site itself needs NO environment variables: the form always posts to /api/lead,
# a server-side proxy that forwards the lead to Telegram:
#   Vercel → api/lead.js (Vercel Function)       — set these in Vercel → Settings → Environment Variables
#   cPanel → public/api/lead.php (via .htaccess) — set them as server env vars or in ~/itboost-lead-config.php
# Do NOT add a PUBLIC_ prefix: PUBLIC_* values are bundled into the browser JavaScript.
#
# Locally this file is only read by `vercel dev` (plain `astro dev` cannot run /api/lead,
# so the form shows its error state there — test sending on a Vercel preview deployment).

# Bot token from @BotFather (rotate the legacy one — it was public on the old site:
# @BotFather -> /mybots -> <bot> -> API Token -> Revoke current token). Mark as Sensitive on Vercel.
TG_BOT_TOKEN=123456789:replace-with-bot-token

# Chat that receives leads
TG_CHAT_ID=123456789
